# Copy to .env and fill secrets before docker compose up

NODE_ENV=production
POSTGRES_USER=billing
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=billing

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

CORS_ORIGIN=https://billing.indiansoftwareservices.com
SEED_SUPERADMIN_EMAIL=admin@indiansoftwareservices.com
SEED_SUPERADMIN_PASSWORD=ChangeMeAdmin123!

# Google Cloud Storage
GCS_PROJECT_ID=
GCS_BUCKET=billing-iss-media
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
# Preferred: mount service-account JSON (used in docker-compose.prod.yml)
GCS_KEY_FILE=/opt/billing/billing-503106-646b7d87cc1e.json
STORAGE_DRIVER=gcs
UPLOAD_DIR=/app/uploads

# Optional e-invoice GSP
EINVOICE_PROVIDER=null
# EINVOICE_API_URL=
# EINVOICE_API_KEY=

# E-way: stub (default) or http bridge to NIC/GSP
EWAY_PROVIDER=stub
# EWAY_API_URL=
# EWAY_API_KEY=
